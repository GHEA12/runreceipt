# RunReceipt configuration — copy to .env and fill in for real Arweave mode.
# Mock mode (default) needs none of this.

# mock  = local anchor registry in data/anchors.json (default, no wallet needed)
# arweave = real Arweave mainnet anchoring (needs a funded wallet JWK below)
ANCHOR_MODE=mock

# Path to the Arweave wallet JWK file (keep this file OUT of version control).
ARWEAVE_WALLET_PATH=/absolute/path/to/arweave-wallet.json

# Gateway used to post and fetch transactions.
ARWEAVE_GATEWAY=https://arweave.net

# Label recorded in every run log as the producing model/engine.
# For LLM-driven tasks set this to the model you actually used.
AGENT_MODEL=runreceipt-rules-v1
AGENT_NAME=runreceipt-agent
